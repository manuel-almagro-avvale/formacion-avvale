            <xsd:element name="Mensaje" type="xsd:string" maxOccurs="1" minOccurs="0"/>
            <xsd:element name="NIF_ConLetra" type="xsd:string" maxOccurs="1" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    <xsd:element name="Z_Operacion_ResponseError">
