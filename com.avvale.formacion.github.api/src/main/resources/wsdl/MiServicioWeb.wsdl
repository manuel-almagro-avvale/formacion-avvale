<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsoap12="http://schemas.xmlsoap.org/wsdl/soap12/" xmlns:tns="http://avvale.com/MiServicioWeb" targetNamespace="http://avvale.com/MiServicioWeb">
  <wsdl:types>
    <xsd:schema targetNamespace="http://avvale.com/MiServicioWeb">
      <xsd:element name="Z_Operacion_Request">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Usuario">
              <xsd:complexType>
                <xsd:sequence>
                  <xsd:element name="Nombre" type="xsd:string" maxOccurs="1" minOccurs="0"/>
                  <xsd:element name="Apellido1" type="xsd:string" maxOccurs="1" minOccurs="0"/>
                  <xsd:element name="Apellido2" type="xsd:string" maxOccurs="1" minOccurs="0"/>
                </xsd:sequence>
              </xsd:complexType>
            </xsd:element>
            <xsd:element name="NIF_SinLetra" type="xsd:string" maxOccurs="1" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="Z_Operacion_Response">
